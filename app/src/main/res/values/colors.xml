<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- #213: the IME wears a recording red during dictation — a constant
         background (the owner: "the background does not pulse"), white text
         and icons on it in BOTH modes. The pulse tilts the foreground toward
         recording_pulse_red at the wave floor (see PulseColorPolicy). -->
    <color name="recording_overlay">#D32F2F</color>
    <color name="recording_text_primary">#FFFFFF</color>
    <color name="recording_divider">#4DFFFFFF</color>
    <color name="recording_icon_tint">#FFFFFF</color>
    <color name="recording_pulse_red">#FFB4A9</color>

    <!-- #212: the quiet control tint (colorControlNormal) — EditText/spinner
         underlines step back while the settings dividers lead (see themes.xml).
         ~20 % opacity, the look the old listDivider hairline had. -->
    <color name="control_quiet">#33000000</color>

    <!-- #161: theme text palette (light). Ratios against the app background #F0F0F3:
         primary 14.3:1, secondary 7.8:1, tertiary 5.05:1, disabled 3.47:1.
         The *_enabled colours are wired into the @color/text_* selectors, never used
         directly — a bare @color name in values/ would collide with res/color/. -->
    <color name="text_primary_enabled">#212121</color>
    <color name="text_secondary_enabled">#4A4A4A</color>
    <color name="text_tertiary_enabled">#666666</color>
    <color name="text_disabled">#808080</color>
</resources>
