<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- #213 correction: the IME BACKGROUND is NEVER tinted — the owner's red
         applies to the FONT only. These stay the neutral palette from before
         the recording-red attempt (white bar in light, black bar in night). -->
    <color name="recording_overlay">#E6FFFFFF</color>
    <color name="recording_text_primary">#000000</color>
    <color name="recording_divider">#4D000000</color>
    <color name="recording_icon_tint">#000000</color>

    <!-- #213 correction: the foreground pulse red — the font is solidly red
         for the WHOLE recording (only the alpha pulses) and pins back to the
         neutral base outside RECORDING. Tuned for red-on-neutral contrast:
         dark red on the light bar, light red on the dark bar. -->
    <color name="recording_pulse_red">#C62828</color>

    <!-- #212: the quiet control tint (colorControlNormal) — EditText/spinner
         underlines step back while the settings dividers lead (see themes.xml).
         ~20 % opacity, the look the old listDivider hairline had. -->
    <color name="control_quiet">#33000000</color>

    <!-- #161: theme text palette (light). Ratios against the app background #F0F0F3:
         primary 14.3:1, secondary 7.8:1, tertiary 5.05:1, disabled 3.47:1.
         The *_enabled colours are wired into the @color/text_* selectors, never used
         directly — a bare @color name in values/ would collide with res/color/. -->
    <color name="text_primary_enabled">#212121</color>
    <color name="text_secondary_enabled">#4A4A4A</color>
    <color name="text_tertiary_enabled">#666666</color>
    <color name="text_disabled">#808080</color>

    <!-- #222: the owned toast strip — the platform-toast look (dark pill,
         light text) in BOTH modes, because it must read as the same message
         channel on every host. The IME service context has no theme
         guarantee (PITFALLS: never theme-derived colours in the IME), so the
         pair is explicit. Light text #F0F0F3 on the pill composites to
         ≥ 9:1 over a light background and ≥ 14:1 over a dark one. -->
    <color name="toast_strip_background">#E6212121</color>
    <color name="toast_strip_text">#F0F0F3</color>
</resources>
