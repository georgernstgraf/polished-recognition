<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PolishedRecognition.Plain" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- #161: the text palette is ours, not the OEM skin's. The platform defaults
             measured 4.00:1 (textColorSecondary) and 1.88:1 (disabled text) on the app
             background; these selectors carry the measured palette from colors.xml. -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <!-- #212: unselected control lines (EditText + spinner underlines) step
             back to a quiet tint; the focused line keeps colorControlActivated.
             The settings dividers take over the leading role (SettingsDivider). -->
        <item name="android:colorControlNormal">@color/control_quiet</item>
    </style>

    <style name="Theme.PolishedRecognition.Plain.Transparent" parent="Theme.PolishedRecognition.Plain">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- #212: the settings screens' item separator — a 1dp line in the measured
         text_secondary palette (light 7.8:1 / night 9.4:1 on the app background),
         so the divider leads while the control underlines stay quiet. -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/text_secondary</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- #213: the app-wide text-button style — every text button in the app
         wears the same visible look (app_button_bg: quiet 1dp border, subtle
         rounded corners, ripple). Text colour stays the theme's
         textColorPrimary selector, so disabled dimming keeps working.
         Padding is EXPLICIT and uniform (4dp all around, owner request after
         the first device look: the platform default gave much vertical,
         zero horizontal padding), and includeFontPadding steps aside so the
         border-to-content distance really reads equal on all four sides. -->
    <style name="AppButton">
        <item name="android:background">@drawable/app_button_bg</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- #213: the Workbench icon-button style — every icon button in the
         Workbench wears it (owner request, continuing the same wave). No own
         background of its own: the borderless ripple stands in for the
         platform ImageButton default, which painted a bordered sheet the
         owner read as a box around each icon. 48dp keeps the touch target at
         the accessibility minimum, and the icon is drawn 1.5x
         (scaleX/scaleY, the IME buttons' pattern) — with the frames gone the
         icons must carry the affordance alone. The ripple is transparent
         until touched, so night mode stays clean (#173). -->
    <style name="WorkbenchIconButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleX">1.5</item>
        <item name="android:scaleY">1.5</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>
