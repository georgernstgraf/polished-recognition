<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PolishedRecognition.Plain" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- #161: the text palette is ours, not the OEM skin's. The platform defaults
             measured 4.00:1 (textColorSecondary) and 1.88:1 (disabled text) on the app
             background; these selectors carry the measured palette from colors.xml. -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
    </style>

    <style name="Theme.PolishedRecognition.Plain.Transparent" parent="Theme.PolishedRecognition.Plain">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- #212: the settings screens' item separator — a 1dp line in the theme's
         listDivider (no hardcoded colour, night mode follows the theme) with
         breathing room on both sides, so consecutive configuration items read
         as separate blocks against the fields' thick underlines. -->
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?android:attr/listDivider</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
</resources>
