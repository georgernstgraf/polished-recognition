<?xml version="1.0" encoding="utf-8"?>
<!-- #161: textColorPrimary selector. Disabled text is dimmed to @color/text_disabled
     (>= 3.0:1, the WCAG floor for disabled controls) instead of the platform's
     translucent 26 % black, which measured 1.88:1 on the "Forget" button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled" />
    <item android:color="@color/text_primary_enabled" />
</selector>
