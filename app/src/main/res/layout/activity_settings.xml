<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Save Button -->
        <Button
            android:id="@+id/save_button_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginBottom="16dp" />

        <!-- Processing Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/processing_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/raw_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/raw_mode"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/target_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_language"
            android:inputType="text"
            android:completionThreshold="1"
            android:focusable="false"
            android:cursorVisible="false"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/target_language_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/target_language_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/manage_custom_languages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_custom_languages"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Prompts Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompts_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- System Prompt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/system_prompt"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />
            <Button
                android:id="@+id/reset_system_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_prompt"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_variables"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <!-- Target Language Clause -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/target_language_clause"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary" />
            <Button
                android:id="@+id/reset_target_language_clause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_prompt"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_variables"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/target_language_clause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp" />

        <!-- Restore All Prompts Button -->
        <Button
            android:id="@+id/restore_defaults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restore_defaults"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- LLM Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/llm_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/llm_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/provider"
            android:inputType="none"
            android:focusable="false"
            android:cursorVisible="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/llm_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_url"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <EditText
                android:id="@+id/llm_token"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/api_token"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
            <ImageButton
                android:id="@+id/llm_token_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_eye"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/show_password"
                android:scaleType="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/fetch_llm_models"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fetch_models"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/test_llm_token"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_token"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/llm_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/model"
            android:inputType="text|textNoSuggestions"
            android:importantForAutofill="no"
            android:completionThreshold="1"
            android:layout_marginBottom="16dp" />

        <!-- STT Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stt_section"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/stt_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/provider"
            android:inputType="none"
            android:focusable="false"
            android:cursorVisible="false"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/stt_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/api_url"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <EditText
                android:id="@+id/stt_token"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/api_token"
                android:inputType="textPassword"
                android:imeOptions="actionDone" />
            <ImageButton
                android:id="@+id/stt_token_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_eye"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/show_password"
                android:scaleType="center" />
        </LinearLayout>

        <Button
            android:id="@+id/validate_stt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/validate_fetch"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/stt_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/model"
            android:inputType="text|textNoSuggestions"
            android:importantForAutofill="no"
            android:completionThreshold="1"
            android:layout_marginBottom="16dp" />

        <!-- Voice Keyboard (IME) Setup -->
        <Button
            android:id="@+id/set_recognition_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_voice_keyboard"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_marginBottom="16dp" />

        <!-- Bottom Save Button -->
        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:layout_marginBottom="24dp" />

        <!-- About Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/about_commit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/about_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_input_info_message"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:clickable="true"
            android:focusable="true"
            android:autoLink="web"
            android:padding="4dp"
            android:layout_marginStart="-4dp" />

    </LinearLayout>
</ScrollView>
