<?xml version="1.0" encoding="utf-8"?>
<!-- #212: the Settings OVERVIEW — target language (write-through as always),
     the four category sub-screens, the voice-keyboard setup and About.
     There is deliberately NO Save button: leaving Settings (back on this
     screen) validates and applies the draft. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Screen title (#212): shows that this is the settings overview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- LLM Control / target-language section (write-through, unchanged ids) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_llm_control"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <AutoCompleteTextView
            android:id="@+id/target_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/target_language"
            android:inputType="text"
            android:completionThreshold="1"
            android:focusable="false"
            android:cursorVisible="false"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/target_language_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/target_language_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/manage_custom_languages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_custom_languages"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp" />

        <View style="@style/SettingsDivider" />

        <!-- The four category sub-screens (owner-approved order) -->
        <Button
            android:id="@+id/category_providers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_providers" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_providers_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/category_prompts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_prompts" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_prompts_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/category_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_output" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_output_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/category_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_advanced" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_advanced_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp" />

        <View style="@style/SettingsDivider" />

        <!-- Voice Keyboard (IME) Setup -->
        <Button
            android:id="@+id/set_recognition_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_voice_keyboard"
            style="@style/AppButton"
            android:layout_marginBottom="16dp" />

        <View style="@style/SettingsDivider" />

        <!-- About Section (#212: title left, Help chip right — space-between) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/about_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_help"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/help_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/about_help" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/about_commit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/about_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_input_info_message"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:clickable="true"
            android:focusable="true"
            android:autoLink="web"
            android:padding="4dp"
            android:layout_marginStart="-4dp" />

    </LinearLayout>
</ScrollView>
