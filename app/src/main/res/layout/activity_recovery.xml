<?xml version="1.0" encoding="utf-8"?>
<!--
  #185: the "pending transcriptions" screen — plain platform views, theme
  attributes only for colours (XmlColorPolicyTest rule 1/2). The rows are
  inflated from item_recovery.xml; no RecyclerView (the app ships no such
  dependency) and no per-row background (#173: selectableItemBackground paints
  an opaque sheet under the night theme).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/recovery_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recovery_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recovery_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/recovery_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
