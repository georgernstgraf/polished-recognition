<?xml version="1.0" encoding="utf-8"?>
<!-- #212: Output Control — the global wrap width + the per-app wrap section
     moved here verbatim from the old single-screen activity_settings.xml. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_category_output"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/wrap_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wrap_width"
            android:inputType="number"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wrap_width_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/wrap_80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wrap_width_preset_80"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />

            <Button
                android:id="@+id/wrap_120"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wrap_width_preset_120"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />

            <Button
                android:id="@+id/wrap_200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wrap_width_preset_200"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />

            <Button
                android:id="@+id/wrap_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wrap_width_preset_off"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_wrap_section"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <AutoCompleteTextView
            android:id="@+id/app_wrap_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/app_wrap_pick"
            android:inputType="none"
            android:focusable="false"
            android:cursorVisible="false"
            android:clickable="true"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/app_wrap_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wrap_width"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/app_wrap_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_wrap_empty"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/app_wrap_forget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_wrap_forget"
                style="@android:style/Widget.DeviceDefault.Button.Borderless" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_wrap_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorTertiary"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
