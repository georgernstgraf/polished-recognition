<?xml version="1.0" encoding="utf-8"?>
<!--
  #169 (epic #166): the Workbench — the app's own editor window.
  Platform views only (the app is Material- and AppCompat-free since #61),
  theme attributes only for colours (XmlColorPolicyTest rule 1/2).

  #173: the header carries a centred ＋ New (title left, Settings right), the
  fields are content-sized (wrap_content + minLines, no inner scrollbar — only
  this ScrollView scrolls), and each label row is a summary-style accordion
  (chevron + label + copy button, plus a one-line ellipsised preview while
  collapsed).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workbench_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/workbench_new"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workbench_new"
                android:textColor="?android:attr/textColorPrimary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/workbench_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/workbench_settings"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/workbench_prev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/workbench_older"
                android:text="◀"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/workbench_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/workbench_next"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/workbench_newer"
                android:text="▶"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/workbench_empty"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="12sp" />

        <!-- Raw: summary row (chevron · label · copy) + collapsed preview. -->
        <LinearLayout
            android:id="@+id/workbench_raw_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="@string/workbench_raw_toggle_desc"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workbench_raw_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:paddingEnd="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_raw"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/workbench_copy_raw"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/workbench_copy_raw_desc"
                android:text="@string/workbench_copy"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_raw_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/workbench_raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/workbench_raw"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:padding="8dp" />

        <!-- Polished: the same accordion shape. -->
        <LinearLayout
            android:id="@+id/workbench_polished_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="@string/workbench_polished_toggle_desc"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workbench_polished_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:paddingEnd="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_polished"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/workbench_copy_polished"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/workbench_copy_polished_desc"
                android:text="@string/workbench_copy"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_polished_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/workbench_polished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/workbench_polished"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/workbench_auto_llm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/workbench_auto_llm"
            android:textColor="?android:attr/textColorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/workbench_language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:completionThreshold="1"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/workbench_language"
                android:inputType="text" />

            <Button
                android:id="@+id/workbench_repolish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/workbench_repolish" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
