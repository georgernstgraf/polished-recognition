<?xml version="1.0" encoding="utf-8"?>
<!--
  #169 (epic #166): the Workbench — the app's own editor window.
  Platform views only (the app is Material- and AppCompat-free since #61),
  theme attributes only for colours (XmlColorPolicyTest rule 1/2).

  #178: the header carries icons only (◀ position ⚙ ＋ ▶), the fields are
  content-sized (wrap_content + minLines, no inner scrollbar — only this
  ScrollView scrolls), and the actions sit in three zones:

  #191: on an INCOMPLETE page the order is header → banner → when-line → the
  four leftover actions → zones → Raw. The reason and the actions it leads to
  stay together at the top; the banner is the one affordance that gets there.

  #189: both sections are `<summary>`-style accordions again (the #173 shape
  #178 dropped): the label row toggles its field and a one-line ellipsised
  preview stands in for the text while it is collapsed. The two action rows
  below are identical — the same promote + empty-polished pair at both Polish
  sites:

    A — above Raw:        target language + Polish
    B — below Raw:        target language + Polish, then promote + empty Polished
    C — below Polished:   promote + empty Polished

  Polished is a READ-ONLY TextView: it is produced by the pipeline and can only
  be promoted or emptied, never edited. No row and no icon button carries an
  `android:background` (#173: `?android:attr/selectableItemBackground` paints an
  opaque sheet in night mode); icons are tinted with theme attributes only.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workbench_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: icons only, the position label in the middle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/workbench_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_older"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left"
                android:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/workbench_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="64dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/workbench_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_settings"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/workbench_new"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_new"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                android:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/workbench_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_newer"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_right"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!--
          #185/#188/#191: the leftovers banner — the ONE affordance that leads
          to an unfinished dictation, directly under the header. It spans the
          page, is painted in the theme accent (accent text on the theme
          background with an accent border: that pair stays readable in both
          modes, unlike an accent FILL), takes the theme's touch height and
          carries a ripple — the whole bar is the tap target. GONE unless the
          journal holds a session that never became text, so an empty state has
          no dead UI and no dead tap target.
        -->
        <TextView
            android:id="@+id/workbench_recovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/workbench_recovery_banner"
            android:gravity="center_vertical"
            android:minHeight="?android:attr/listPreferredItemHeightSmall"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
            android:textColor="?android:attr/colorAccent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!--
          #188: the "when" line of the shown page. A stored dictation shows its
          last change, a leftover its start plus seconds · fragments · reason.
          Empty on the compose slot, so the line takes no room there.
        -->
        <TextView
            android:id="@+id/workbench_stamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          #188/#191: the four actions of an unfinished dictation — directly
          under the when-line, so the reason and the way out sit together (the
          device check paged 1/3 · 2/3 · 3/3 before finding them at the bottom).
          Visible only while a leftover page is shown; every enable state comes
          from RecoveryActions, never from XML. Equal weights keep the long
          labels inside the page on a narrow screen — a button wraps its text,
          the row never scrolls on its own.
        -->
        <LinearLayout
            android:id="@+id/workbench_leftover_actions"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/workbench_retry_stt"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_retry_stt" />

            <Button
                android:id="@+id/workbench_restore_text"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_restore_text"
                android:visibility="gone" />

            <Button
                android:id="@+id/workbench_share_audio"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/workbench_share_audio" />

            <Button
                android:id="@+id/workbench_dismiss_leftover"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/workbench_dismiss_leftover" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_empty_hint"            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/workbench_empty"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="12sp" />

        <!-- Zone A: target language + Polish, above Raw. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/workbench_language_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:completionThreshold="1"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/workbench_language"
                android:inputType="text" />

            <Button
                android:id="@+id/workbench_polish_a"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_polish"
                android:drawablePadding="4dp"
                android:drawableTint="?android:attr/textColorPrimary"
                android:text="@string/workbench_polish"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!--
          Raw: the summary row (chevron · label · copy) then the editable field.
          #189: a tap on the row collapses or expands the field — the whole row
          is the tap target, the chevron says which state it is in, and a
          one-line ellipsised preview stands in for the text while collapsed.
        -->
        <LinearLayout
            android:id="@+id/workbench_raw_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="@string/workbench_raw_toggle_desc"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workbench_raw_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:paddingStart="0dp"
                android:paddingEnd="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_raw"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/workbench_copy_raw"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/workbench_copy_raw_desc"
                android:scaleType="centerInside"
                android:src="@drawable/ic_copy"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_raw_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/workbench_raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/workbench_raw"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:padding="8dp" />

        <!-- Zone B: the same Polish site below Raw, plus promote and empty. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/workbench_language_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:completionThreshold="1"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/workbench_language"
                android:inputType="text" />

            <Button
                android:id="@+id/workbench_polish_b"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_polish"
                android:drawablePadding="4dp"
                android:drawableTint="?android:attr/textColorPrimary"
                android:text="@string/workbench_polish"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!--
          #189: the two action rows are IDENTICAL — promote (an up arrow: the
          polished text moves up into Raw) and the trash can (empty the polished
          slot) at both Polish sites. The trash sits in the bottom bar under
          Polished as well as under Raw, so neither action needs a scroll.
        -->
        <LinearLayout
            android:id="@+id/workbench_actions_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/workbench_promote_b"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_promote"
                android:scaleType="centerInside"
                android:src="@drawable/ic_promote"
                android:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/workbench_clear_polished_b"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_clear_polished"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete_outline"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!--
          Polished: the same accordion shape as Raw (#189) — summary row
          (chevron · label · copy), collapsed preview, then the READ-ONLY text.
        -->
        <LinearLayout
            android:id="@+id/workbench_polished_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="@string/workbench_polished_toggle_desc"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/workbench_polished_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:paddingStart="0dp"
                android:paddingEnd="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workbench_polished"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/workbench_copy_polished"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/workbench_copy_polished_desc"
                android:scaleType="centerInside"
                android:src="@drawable/ic_copy"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/workbench_polished_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/workbench_polished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:longClickable="false"
            android:minLines="2"
            android:padding="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp" />

        <!-- Zone C: the same promote + empty pair as zone B, in the bottom bar. -->
        <LinearLayout
            android:id="@+id/workbench_actions_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/workbench_promote_c"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_promote"
                android:scaleType="centerInside"
                android:src="@drawable/ic_promote"
                android:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/workbench_clear_polished_c"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workbench_clear_polished"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete_outline"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
