<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/recording_overlay"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/ime_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ime_status_idle"
        android:textColor="@color/recording_text_primary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/ime_cancel_button"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/ime_cancel"
            android:textColor="@color/recording_text_primary" />

        <Button
            android:id="@+id/ime_mic_button"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/ime_record"
            android:drawableTop="@drawable/ic_mic"
            android:textColor="@color/recording_text_primary" />

    </LinearLayout>
</LinearLayout>
