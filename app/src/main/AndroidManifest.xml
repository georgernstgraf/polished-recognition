<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".PolishedRecognitionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PolishedRecognition.Plain">

        <activity
            android:name=".ui.WorkbenchActivity"
            android:exported="true"
            android:theme="@style/Theme.PolishedRecognition.Plain"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PolishedRecognition.Plain" />

        <!-- #185: the pending-transcriptions list. -->
        <activity
            android:name=".ui.RecoveryActivity"
            android:exported="false"
            android:theme="@style/Theme.PolishedRecognition.Plain" />

        <!--
          #185: hands the recovery audio to a share target. The journal lives
          under files/ (read-only grant per URI) and the reconstructed WAV under
          cache/; both are private to the app until the chooser grants them.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.recovery"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recovery_paths" />
        </provider>

        <activity
            android:name=".ui.HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.PolishedRecognition.Plain" />

        <activity
            android:name=".ui.CrashDialogActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.PolishedRecognition.Plain.Transparent" />

        <activity
            android:name=".ui.SettingsHintActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.PolishedRecognition.Plain.Transparent" />

        <activity
            android:name=".ui.MicrophonePermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.PolishedRecognition.Plain.Transparent"
            android:excludeFromRecents="true" />

        <service
            android:name=".service.PolishedVoiceInputIME"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/voice_method" />
        </service>

        <service
            android:name=".service.PolishedRecognitionService"
            android:enabled="@bool/recognition_service_enabled"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
